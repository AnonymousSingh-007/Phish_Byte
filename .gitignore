# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Model weights & checkpoints ───────────────────────────────────────────────
# These live on HuggingFace Hub — download with from_pretrained()
phishbyte/model/weights/
*.pt
*.pth
*.ckpt
*.safetensors

# ── Feature extraction cache ──────────────────────────────────────────────────
# Large binary files — rebuilt automatically by train.py (takes ~3 min)
train/cache/
*.pkl

# ── Training artifacts ────────────────────────────────────────────────────────
train/runs/
train/logs/
*.log

# ── Dataset files ─────────────────────────────────────────────────────────────
# Too large for git. Download instructions in train/README.md
data/
*.csv
*.eml
*.tar.bz2
*.zip
*.bz2

# ── Private deployment scripts ────────────────────────────────────────────────
# These contain or reference your HuggingFace token workflow.
# Keep local — do not push to public repo.
push_to_hub.py
update_hub_metadata.py

# ── SHAP cache ────────────────────────────────────────────────────────────────
shap_cache/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Build / packaging ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb